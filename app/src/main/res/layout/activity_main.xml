<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- Title at the top -->
    <ImageView
        android:id="@+id/listTitle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/list"
        android:layout_margin="16dp"
        android:scaleType="centerInside"
        android:contentDescription="列表标题"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- RecyclerView for task list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/taskRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/listTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Improved GridLayout for 2x2 quadrant layout -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/quadrantLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:columnCount="2"
        app:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/listTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Quadrant 1: Top-left (重要且紧急) -->
        <LinearLayout
            android:id="@+id/quadrant1Tasks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:background="#FFCDD2"
            android:padding="8dp"
            app:layout_column="0"
            app:layout_row="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <TextView
                android:id="@+id/quadrant1TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重要且紧急"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Quadrant 2: Top-right (重要但不紧急) -->
        <LinearLayout
            android:id="@+id/quadrant2Tasks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:background="#C8E6C9"
            android:padding="8dp"
            app:layout_column="1"
            app:layout_row="0"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <TextView
                android:id="@+id/quadrant2TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重要不紧急"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Quadrant 3: Bottom-left (不重要但紧急) -->
        <LinearLayout
            android:id="@+id/quadrant3Tasks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:background="#FFE0B2"
            android:padding="8dp"
            app:layout_column="0"
            app:layout_row="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <TextView
                android:id="@+id/quadrant3TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不重要但紧急"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Quadrant 4: Bottom-right (不重要且不紧急) -->
        <LinearLayout
            android:id="@+id/quadrant4Tasks"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:background="#E1BEE7"
            android:padding="8dp"
            app:layout_column="1"
            app:layout_row="1"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1">

            <TextView
                android:id="@+id/quadrant4TextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不重要不紧急"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/black" />
        </LinearLayout>

    </androidx.gridlayout.widget.GridLayout>

    <!-- 任务输入面板 (初始隐藏) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/taskInputPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/modern_dialog_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="添加新任务"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/taskInputField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="输入任务内容"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/modern_input_field"
                android:fontFamily="sans-serif"
                android:textColor="#2C3E50"
                android:textColorHint="#6C757D"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择象限"
                android:textSize="14sp"
                android:textColor="#495057"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/quadrantSelector"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/modern_spinner"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置执行时间（默认为当前时间）"
                android:textSize="14sp"
                android:textColor="#495057"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSelectDateTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="选择执行时间"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:background="@drawable/button_time_selector"
                android:minHeight="48dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/cancelTaskButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="取消"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/cancel_button"
                    android:textColor="@color/white"/>

                <Button
                    android:id="@+id/submitTaskButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="提交"
                    android:textSize="14sp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/submit_button"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 悬浮添加任务按钮 -->
    <ImageButton
        android:id="@+id/addTaskButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_add_task"
        android:background="@drawable/fab_add_simple"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="添加任务"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 悬浮切换布局按钮 -->
    <ImageButton
        android:id="@+id/toggleLayoutButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_toggle_view"
        android:background="@drawable/fab_toggle_simple"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="切换布局"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/addTaskButton" />

</androidx.constraintlayout.widget.ConstraintLayout>